{
  "name": "ferreteria-pos-system",
  "version": "1.0.0",
  "description": "Sistema POS y Control de Inventarios para Ferretería - Bolivia",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "node --watch backend/server.js",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "cd frontend && npm run build",
    "start": "node backend/server.js",
    "setup": "node scripts/setup.js",
    "init-db": "node scripts/init-database.js"
  },
  "keywords": [
    "pos",
    "inventory",
    "ferreteria",
    "bolivia"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^10.0.0",
    "express": "^4.17.1",
    "express-rate-limit": "^5.5.1",
    "helmet": "^4.6.0",
    "jsonwebtoken": "^8.5.1",
    "multer": "^1.4.5-lts.1",
    "sqlite3": "^5.0.0"
  },
  "devDependencies": {
    "caxa": "^3.0.1",
    "concurrently": "^8.2.2",
    "pkg": "^5.8.1"
  },
  "pkg": {
    "targets": [
      "node18-win-x86",
      "node18-win-x64"
    ],
    "outputPath": "./dist",
    "scripts": [
      "backend/**/*.js",
      "frontend/dist/**/*"
    ],
    "assets": [
      "frontend/dist/**/*",
      "database/schema.sql",
      ".env.example"
    ],
    "icon": "./icon.ico"
  },
  "bin": "backend/server.js"
}
