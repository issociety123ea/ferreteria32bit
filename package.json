{
  "name": "ferreteria-pos-system",
  "version": "1.0.0",
  "description": "Sistema POS y Control de Inventarios para Ferretería - Bolivia",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "node --watch backend/server.js",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "cd frontend && npm run build",
    "start": "node backend/server.js",
    "setup": "node scripts/setup.js",
    "init-db": "node scripts/init-database.js"
  },
  "keywords": ["pos", "inventory", "ferreteria", "bolivia"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "sqlite3": "^5.1.6",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "pkg": "^5.11.5"
  },
  "pkg": {
    "targets": [
      "node18-win-x86",
      "node18-win-x64"
    ],
    "outputPath": "./dist",
    "scripts": [
      "backend/**/*.js",
      "frontend/dist/**/*"
    ],
    "assets": [
      "frontend/dist/**/*",
      "database/schema.sql",
      ".env.example"
    ],
    "icon": "./icon.ico"
  },
  "bin": "backend/server.js"
}
